@article{Albertini2020,
title = {Subspace controllability of bipartite symmetric spin networks},
journal = {Linear Algebra and its Applications},
volume = {585},
pages = {1-23},
year = {2020},
issn = {0024-3795},
doi = {https://doi.org/10.1016/j.laa.2019.09.034},
url = {https://www.sciencedirect.com/science/article/pii/S0024379519304239},
author = {Francesca Albertini and Domenico D'Alessandro},
keywords = {Controllability of quantum systems, Spin networks, Symmetry groups, Dynamical decomposition, Subspace controllability},
abstract = {We consider a class of spin networks where each spin in a certain set interacts, via Ising coupling, with a set of central spins, and the control acts simultaneously on all the spins. Due to the permutation symmetries of the network, the system is not globally controllable but it displays invariant subspaces of the underlying Hilbert space. The system is said to be subspace controllable if it is controllable on each of these subspaces. We characterize the given invariant subspaces and the dynamical Lie algebra of this class of systems and prove subspace controllability in every case.}
}

